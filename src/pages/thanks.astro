---
import Base from "../layouts/Base.astro";
import { images, steamUrl, thanks } from "../content/site";
---

<Base title={thanks.title} description={thanks.description} ogImage={images.ogHome} ogAlt={images.ogHomeAlt}>
  <main id="main" tabindex="-1">
    <section class="not-found">
      <div class="site-shell stack" style="align-items: center; text-align: center;">
        <p class="eyebrow">{thanks.eyebrow}</p>
        <h1 class="section-title">{thanks.h1}</h1>
        <p class="lede">{thanks.body}</p>
        <a class="btn btn-primary" href={steamUrl("thanks")} target="_blank" rel="noopener noreferrer">
          {thanks.cta}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </section>
  </main>
</Base>
