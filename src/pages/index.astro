---
import Base from "../layouts/Base.astro";
import CoverImage from "../components/CoverImage.astro";
import SignupForm from "../components/SignupForm.astro";
import {
  amazonUrl,
  authorLine,
  home,
  images,
  siteName,
  siteUrl,
  steamAppId,
  steamShort,
  steamUrl,
  studio,
} from "../content/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: siteName,
  description: steamShort,
  url: siteUrl,
  image: new URL(images.ogHome, siteUrl).href,
  gamePlatform: "PC",
  playMode: "SinglePlayer",
  genre: "Sci-fi action RPG",
  author: {
    "@type": "Person",
    name: "Matthew Snodgrass",
  },
  publisher: {
    "@type": "Organization",
    name: studio,
  },
  sameAs: "https://store.steampowered.com/app/4032180/Sovereign_Call_Origins/",
  identifier: steamAppId,
};
---

<Base
  title={home.title}
  description={home.description}
  ogImage={images.ogHome}
  ogAlt={images.ogHomeAlt}
  jsonLd={jsonLd}
  preloadCover
>
  <main id="main" tabindex="-1">
    <section class="game-hero" id="game" aria-labelledby="game-title">
      <div class="site-shell game-hero-grid">
        <div class="stack">
          <p class="status-chip">{home.hero.status}</p>
          <h1 id="game-title" class="game-title">
            Sovereign Call: <span class="gold">Origins</span>
          </h1>
          <p class="game-headline">{home.hero.headline}</p>
          <p class="lede">{home.hero.sub}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={steamUrl("hero")} target="_blank" rel="noopener noreferrer">
              {home.hero.primary}<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a class="text-link" href="#signup">{home.hero.secondary}</a>
          </div>
        </div>
        <!-- TODO(media): Replace this novel cover with current-build key art when a capture exists. Do not use the legacy demo. -->
        <CoverImage class="hero-cover" priority sizes="(min-width: 48rem) 370px, 76vw" />
      </div>
    </section>

    <section class="section-space band" aria-labelledby="gameplay-heading">
      <div class="site-shell split">
        <div class="stack">
          <p class="eyebrow">{home.gameplay.eyebrow}</p>
          <h2 id="gameplay-heading" class="section-title">{home.gameplay.title}</h2>
          <p class="lede">{home.gameplay.body}</p>
          <a class="text-link" href="#signup">{home.gameplay.link}</a>
        </div>
        <CoverImage class="hero-cover" sizes="(min-width: 48rem) 320px, 70vw" />
      </div>
    </section>

    <section class="section-space" aria-labelledby="sides-heading">
      <div class="site-shell stack">
        <p class="copy-todo">{home.protagonists.placeholder}</p>
        <p class="eyebrow">{home.protagonists.eyebrow}</p>
        <h2 id="sides-heading" class="section-title">{home.protagonists.title}</h2>
        <div class="protag-grid">
          <article class="protag-card tarrik">
            <h3>{home.protagonists.tarrikName}</h3>
            <p>{home.protagonists.tarrik}</p>
          </article>
          <article class="protag-card selene">
            <h3>{home.protagonists.seleneName}</h3>
            <p>{home.protagonists.selene}</p>
          </article>
        </div>
        <p class="lede">{home.protagonists.threat}</p>
      </div>
    </section>

    <section class="section-space band" aria-labelledby="echo-heading">
      <div class="site-shell stack">
        <p class="copy-todo">{home.combat.placeholder}</p>
        <p class="eyebrow">{home.combat.eyebrow}</p>
        <h2 id="echo-heading" class="section-title">{home.combat.title}</h2>
        <p class="lede">{home.combat.body}</p>
      </div>
    </section>

    <section class="section-space" id="book" aria-labelledby="novel-heading">
      <div class="site-shell stack">
        <p class="copy-todo">{home.novel.placeholder}</p>
        <div class="novel-strip">
          <a class="novel-thumb" href="/book">
            <CoverImage sizes="120px" />
          </a>
          <div class="stack">
            <p class="eyebrow">{home.novel.eyebrow}</p>
            <h2 id="novel-heading" class="section-title">{home.novel.title}</h2>
            {home.novel.lines.map((line) => <p class="lede">{line}</p>)}
            <p id="author">{authorLine}</p>
            <div class="cluster">
              <a id="excerpt" class="text-link" href="/book#excerpt">{home.novel.read}</a>
              <a class="text-link" href={amazonUrl} target="_blank" rel="noopener noreferrer">
                {home.novel.amazon}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SignupForm />

    <section class="closing-section" aria-labelledby="close-heading">
      <div class="site-shell closing-content">
        <p class="eyebrow">{home.closing.eyebrow}</p>
        <h2 id="close-heading" class="closing-title">
          {home.closing.titleLead}<span class="sr-only"> </span><span class="gold italic">{home.closing.titleEm}</span>
        </h2>
        <p class="game-headline">{home.closing.line}</p>
        <a class="btn btn-primary" href={steamUrl("footer_cta")} target="_blank" rel="noopener noreferrer">
          {home.closing.cta}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </section>
  </main>
</Base>
