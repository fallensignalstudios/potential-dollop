---
import Base from "../layouts/Base.astro";
import CoverImage from "../components/CoverImage.astro";
import SignupForm from "../components/SignupForm.astro";
import { amazonUrl, authorLine, home, images, siteUrl, steamUrl, studio } from "../content/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: "Sovereign Call: Origins",
  description: home.ogDescription,
  genre: "Action RPG",
  gamePlatform: "PC",
  author: {
    "@type": "Organization",
    name: studio,
  },
  url: `${siteUrl}/`,
  image: new URL(images.ogHome, siteUrl).href,
  sameAs: "https://store.steampowered.com/app/4032180/Sovereign_Call_Origins/",
};
---

<Base
  title={home.title}
  description={home.description}
  ogTitle={home.ogTitle}
  ogDescription={home.ogDescription}
  ogImage={images.ogHome}
  ogAlt={images.ogHomeAlt}
  jsonLd={jsonLd}
  preloadCover
>
  <main id="main" tabindex="-1">
    <section class="game-hero" aria-labelledby="game-title">
      <div class="site-shell game-hero-grid">
        <div class="stack">
          <p class="eyebrow">{home.hero.eyebrow}</p>
          <h1 id="game-title" class="game-title">
            Sovereign Call: <span class="gold">Origins</span>
          </h1>
          <p class="game-headline">{home.hero.headline}</p>
          <p class="lede">{home.hero.sub}</p>
          <p class="status-chip">{home.hero.status}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={steamUrl("hero")} target="_blank" rel="noopener noreferrer">
              {home.hero.primary}<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a class="text-link" href="#updates">{home.hero.secondary}</a>
          </div>
        </div>
        <!-- TODO(media): Key art or a current Aurelion-build capture. Never the April 2026 demo. -->
        <CoverImage class="hero-cover" priority sizes="(min-width: 48rem) 370px, 76vw" />
      </div>
    </section>

    <section class="section-space" id="game" aria-labelledby="sides-heading">
      <div class="site-shell stack">
        <h2 id="sides-heading" class="section-title">{home.protagonists.title}</h2>
        <p class="lede">{home.protagonists.intro}</p>
        <div class="protag-grid">
          <article class="protag-card tarrik">
            <h3>{home.protagonists.tarrikName}</h3>
            <p>{home.protagonists.tarrik}</p>
          </article>
          <article class="protag-card selene">
            <h3>{home.protagonists.seleneName}</h3>
            <p>{home.protagonists.selene}</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section-space band" aria-labelledby="combat-heading">
      <div class="site-shell stack">
        <h2 id="combat-heading" class="section-title">{home.combat.title}</h2>
        <p class="lede">{home.combat.body}</p>
        <p><span class="copy-todo">{home.combat.confirm}</span></p>
      </div>
    </section>

    <section class="section-space" aria-labelledby="companions-heading">
      <div class="site-shell stack">
        <h2 id="companions-heading" class="section-title">{home.companions.title}</h2>
        <p class="lede">{home.companions.body}</p>
        <p><span class="copy-todo">{home.companions.confirm}</span></p>
      </div>
    </section>

    <section class="section-space band" aria-labelledby="eclipse-heading">
      <div class="site-shell stack">
        <h2 id="eclipse-heading" class="section-title">{home.eclipse.title}</h2>
        <p class="lede">{home.eclipse.body}</p>
        <p><span class="copy-todo">{home.eclipse.confirm}</span></p>
      </div>
    </section>

    <section class="section-space" id="book" aria-labelledby="novel-heading">
      <div class="site-shell novel-strip">
        <a class="novel-thumb" href="/book">
          <CoverImage sizes="120px" />
        </a>
        <div class="stack">
          <h2 id="novel-heading" class="section-title">{home.novel.title}</h2>
          <p class="lede">{home.novel.body}</p>
          <p id="author">{authorLine}</p>
          <div class="cluster">
            <a id="excerpt" class="text-link" href="/book#excerpt">{home.novel.read}</a>
            <a class="text-link" href={amazonUrl} target="_blank" rel="noopener noreferrer">
              {home.novel.amazon}<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-space band" aria-labelledby="status-heading">
      <div class="site-shell stack">
        <h2 id="status-heading" class="section-title">{home.status.title}</h2>
        <p class="lede">{home.status.body}</p>
        <p class="lede">{home.status.demo}</p>
        <a class="btn btn-primary" href={steamUrl("status")} target="_blank" rel="noopener noreferrer">
          {home.status.cta}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </section>

    <SignupForm />

    <section class="closing-section" aria-labelledby="close-heading">
      <div class="site-shell closing-content">
        <h2 id="close-heading" class="section-title">{home.closing.line}</h2>
        <a class="btn btn-primary" href={steamUrl("footer_cta")} target="_blank" rel="noopener noreferrer">
          {home.closing.cta}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </section>
  </main>
</Base>
