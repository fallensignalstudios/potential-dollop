---
import { statSync } from "node:fs";
import Base from "../layouts/Base.astro";
import { images, press, pressEmail, siteUrl, socials, steamUrl } from "../content/site";

const introParts = press.intro.split(pressEmail);
const logoPackZipBytes = statSync(new URL("../../public/press/logo-pack/logo-pack.zip", import.meta.url)).size;
const logoPackZipSize = `${(logoPackZipBytes / (1024 * 1024)).toFixed(1)} MB`;
---

<Base
  title={press.title}
  description={press.description}
  ogTitle={press.ogTitle}
  ogDescription={press.ogDescription}
  ogImage={images.ogHome}
  ogAlt={images.ogHomeAlt}
>
  <main id="main" tabindex="-1">
    <header class="site-shell page-intro">
      <h1 class="section-title">{press.h1}</h1>
      <p class="lede">
        {introParts[0]}<a class="text-link" href={`mailto:${pressEmail}`}>{pressEmail}</a>{introParts[1]}
      </p>
    </header>

    <div class="site-shell">
      <section class="press-section" id="factsheet" aria-labelledby="factsheet-heading">
        <h2 id="factsheet-heading" class="section-title">{press.factsheet.heading}</h2>
        <dl class="factsheet">
          {
            press.factsheet.rows.map((row) => (
              <div>
                <dt>{row.term}</dt>
                <dd>
                  {row.term === "Website" ? (
                    <a class="text-link" href={siteUrl}>
                      {siteUrl}
                    </a>
                  ) : row.term === "Steam" ? (
                    <a class="text-link" href={steamUrl("press")} target="_blank" rel="noopener noreferrer">
                      Wishlist on Steam, app 4032180<span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  ) : row.term === "Press contact" ? (
                    <a class="text-link" href={`mailto:${pressEmail}`}>{pressEmail}</a>
                  ) : row.term === "Socials" ? (
                    socials.map((item, index) => (
                      <>
                        {index > 0 ? " · " : null}
                        {item.label}{" "}
                        <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">
                          {item.href}
                          <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                      </>
                    ))
                  ) : row.todo ? (
                    <>
                      {row.value ? <>{row.value} </> : null}
                      <span class="copy-todo">{row.todo}</span>
                    </>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="press-section" id="description" aria-labelledby="short-heading">
        <h2 id="short-heading" class="section-title">{press.short.heading}</h2>
        <p class="lede">{press.short.body}</p>
      </section>

      <section class="press-section" id="long-description" aria-labelledby="long-heading">
        <h2 id="long-heading" class="section-title">{press.long.heading}</h2>
        <div class="prose-block">
          {press.long.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="press-section" id="history" aria-labelledby="history-heading">
        <h2 id="history-heading" class="section-title">{press.history.heading}</h2>
        <div class="prose-block">
          <p>{press.history.body}</p>
        </div>
      </section>

      <section class="press-section" id="assets" aria-labelledby="assets-heading">
        <h2 id="assets-heading" class="section-title">{press.assets.heading}</h2>
        <ul class="download-list">
          <li>
            <a class="text-link" href={press.assets.emblem.png}>{press.assets.emblem.pngLabel}</a>
          </li>
          <li>
            <a class="text-link" href={press.assets.emblem.svg}>{press.assets.emblem.svgLabel}</a>
          </li>
        </ul>
        <p>{press.assets.note}</p>
        <p>
          <a class="text-link" href={press.assets.logoPack.zip}>Logo pack, ZIP, {logoPackZipSize}</a>
        </p>
        <ul class="logo-pack">
          {
            press.assets.logoPack.files.map((file) => (
              <li>
                <a class="logo-pack-link" href={file.href}>
                  <img src={file.thumb} alt="" width={file.width} height={file.height} />
                  <span>{file.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="logo-pack-note">The zip also includes the emblem PNG and SVG linked above.</p>
        <ul class="download-list">
          {
            press.assets.items.map((item) => (
              <>
                {item.startsWith("Trailer") ? (
                  <li>
                    <a class="text-link" href={press.assets.steamCapsule.href}>
                      {press.assets.steamCapsule.label}
                    </a>
                  </li>
                ) : null}
                <li>
                  <span class="copy-todo">{item}</span>
                </li>
              </>
            ))
          }
        </ul>
      </section>

      <section class="press-section" id="contact" aria-labelledby="contact-heading">
        <h2 id="contact-heading" class="section-title">{press.contact.heading}</h2>
        <p>
          {press.contact.body}{" "}
          <a class="text-link" href={`mailto:${pressEmail}`}>{pressEmail}</a>
        </p>
      </section>

      <section class="press-section" id="boilerplate" aria-labelledby="boilerplate-heading">
        <h2 id="boilerplate-heading" class="section-title">{press.boilerplate.heading}</h2>
        <p class="lede">{press.boilerplate.body}</p>
      </section>
    </div>
  </main>
</Base>
